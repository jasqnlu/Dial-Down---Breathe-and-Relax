<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Store privacy manifest — Breath - Relax & Stretch (main app target).

	  NSPrivacyAccessedAPITypes: this app is confirmed to use ONE required-reason
	  API category — User Defaults — via:
	    - UserDefaults.standard, used throughout the app's own container for
	      onboarding flags, settings, auth/session state, and streak/points
	      tracking (e.g. AuthManager.swift, HomeView.swift, BodyMapView.swift,
	      VoiceCueService.swift, BreathingModels.swift). Reason CA92.1 covers
	      this (read/write info accessible only to the app itself).

	  Previously also declared reason 1C8F.1 (App Group UserDefaults) for
	  Services/WidgetDataService.swift, which shared streak/session data with
	  a planned Widget/Watch complication target. That service and the
	  widget/watch idea were dropped entirely 2026-09-10 — removed here too,
	  since the app no longer touches App Group UserDefaults at all.

	  No other required-reason API categories are used:
	    - File Timestamp APIs: FileManager is only used to look up
	      .documentDirectory / .temporaryDirectory URLs (ProfileView.swift,
	      DataExportView.swift, BodyAnnotationOverlay.swift) — no
	      .creationDate/.modificationDate/attribute access anywhere.
	    - Disk space APIs: not used anywhere in the codebase.
	    - System boot time APIs (systemUptime): not used anywhere.
	    - Active keyboard APIs: not used anywhere.

	  NSPrivacyCollectedDataTypes: two categories of data leave the device.

	    1. Profile and opt-in leaderboard data (SupabaseService.uploadProfile /
	       joinLeaderboard; RemoteProfile and RemoteLeaderboardRow in
	       Services/SupabaseDTOs.swift):
	         - A private profile row (real name, points/streak/total-minutes,
	           last session time) readable and writable ONLY by its owner, used
	           to restore the account and to send streak reminders.
	         - If, and only if, the user taps Join in LeaderboardView: a
	           generated pseudonymous handle (never a real name) plus
	           points/streak/total-minutes, visible to other signed-in users
	           without any user id. Leaving deletes it.
	       Both are keyed by the Supabase auth UUID (AuthManager.backendID).

	    2. Email address, sent to our authentication provider (Supabase) when
	       creating or signing into an account via Sign in with Apple,
	       Google, or email/password (SupabaseService.swift's
	       signInWithApple/signInWithGoogle/signUpWithPassword/
	       signInWithPassword). Used solely to verify identity on future
	       sign-ins; never stored in the leaderboard row.

	  The private profile row's first_name/last_name/display_name columns
	  (RemoteProfileName in SupabaseDTOs.swift, written by the name step) are
	  declared below as NSPrivacyCollectedDataTypeName.

	  Apple Health (HealthKit) and Calendar (EventKit) data is read and
	  written on-device only and never uploaded, so neither is declared here.

	  None of these categories is used for tracking.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUsageData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
