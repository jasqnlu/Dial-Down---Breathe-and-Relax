    "Announces exercise names and breathing phases aloud during sessions. Auto-skip jumps straight into each exercise without the 3-2-1 countdown." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuncia en voz alta los nombres de los ejercicios y las fases de respiración durante las sesiones. Omitir automáticamente salta directo a cada ejercicio sin la cuenta regresiva 3-2-1."
          }
        },
        "fr" : {
          "stringUnit" : {
