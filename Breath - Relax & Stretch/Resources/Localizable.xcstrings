    },
    "This permanently deletes your account, your progress and leaderboard entry on our servers, and all app data on this iPhone, including session history, routines, and body-map marks. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina de forma permanente tu cuenta, tu progreso y tu entrada en la clasificación de nuestros servidores, y todos los datos de la app en este iPhone, incluido el historial de sesiones, las rutinas y las marcas del mapa corporal. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement votre compte, votre progression et votre entrée au classement de nos serveurs, ainsi que toutes les données de l'app sur cet iPhone, y compris l'historique des séances, les routines et les marques de la carte du corps. Elle est irréversible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除你的账户、我们服务器上的进度和排行榜记录，以及此 iPhone 上的所有应用数据，包括训练记录、训练计划和身体图谱标记。此操作无法撤销。"
          }
        }
      }
    },
