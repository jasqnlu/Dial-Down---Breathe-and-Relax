    "\"%@\" will be permanently deleted. This can't be undone." : {
      "comment" : "A confirmation dialog message for deleting a routine. The argument is the name of the routine to be deleted.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" se eliminará permanentemente. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera définitivement supprimé. Cette action est irréversible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将被永久删除。此操作无法撤销。"
